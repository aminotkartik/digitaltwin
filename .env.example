# ===========================================================================
# VitalSync — environment configuration template
# ===========================================================================
# Copy this file to `.env` at the repository root and edit:
#
#     cp .env.example .env
#
# `.env` is git-ignored and is read by the BACKEND ONLY. The browser never
# receives any value from this file. Every setting has a safe default, so the
# prototype runs with an empty `.env` — the Groq interpretation layer simply
# switches to its deterministic fallback.
#
# SECURITY: never commit a real key. If a key leaks, revoke it in the Groq
# console and rotate it.
# ===========================================================================

# ---------------------------------------------------------------------------
# Groq — natural-language clinical interpretation ONLY
#
# This layer phrases observations about a prediction that a separate statistical
# model produced. It never generates a probability, a diagnosis or a threshold.
# Leave blank to run fully offline; the UI then shows:
#   "Groq interpretation layer disabled — deterministic prototype mode active."
# ---------------------------------------------------------------------------
GROQ_API_KEY=

# Model name is configurable, never hardcoded in the source.
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TIMEOUT_SECONDS=25
GROQ_MAX_TOKENS=900
GROQ_TEMPERATURE=0.2

# Force the deterministic fallback even when a key is present. Useful for
# demonstrating the offline path, or for air-gapped judging.
GROQ_FORCE_DISABLED=false

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=prototype
APP_VERSION=1.0.0

# ---------------------------------------------------------------------------
# Clinical event definition (reviewed as a unit — keep in sync with the model)
#
# Target event: within the next FORECAST_HORIZON_MINUTES, glucose reaches
# GLUCOSE_HIGH_THRESHOLD_MGDL for at least 10 consecutive minutes AND that peak
# is at least GLUCOSE_RISE_DELTA_MGDL above the value at the prediction instant.
# 180 mg/dL is the hyperglycaemic bound of the ATTD international consensus on
# time in range.
#
# Changing these values invalidates the committed model artifacts — retrain with:
#     python model/train.py --regenerate
# ---------------------------------------------------------------------------
GLUCOSE_HIGH_THRESHOLD_MGDL=180
GLUCOSE_RISE_DELTA_MGDL=25
GLUCOSE_LOW_THRESHOLD_MGDL=70
FORECAST_HORIZON_MINUTES=120

# Display bands for the risk card (distinct from the model's operating
# threshold, which is chosen by max-F1 on validation patients at training time).
RISK_MODERATE_MIN=0.35
RISK_HIGH_MIN=0.70

# ---------------------------------------------------------------------------
# Signal & replay
# ---------------------------------------------------------------------------
SAMPLING_INTERVAL_MINUTES=5
STREAM_HOURS=72
BASELINE_ONBOARDING_HOURS=48
DEMO_PATIENT_ID=DT-1047

# The twin replays a scripted scenario day, so "now" is a fixed clock time
# rather than the wall clock. This keeps the clinical narrative identical every
# time the prototype is demonstrated.
DEMO_STREAM_END_CLOCK=15:00
DEMO_NOW_CLOCK=10:45
DEMO_SIMULATION_START_CLOCK=09:30

# Calendar date (ISO) of the scenario day. Pinning it makes the demo
# bit-reproducible: the committed provenance files under
# backend/data/sensor_data/ never churn and the rehearsed risk arc
# (LOW 09:30 -> MODERATE 10:45 -> HIGH 11:15 -> spike 13:45) holds on any day.
# Leave empty to follow the machine's date instead.
DEMO_ANCHOR_DATE=2026-10-05

# ---------------------------------------------------------------------------
# Model selection
#   auto      pick the strongest available estimator
#   xgboost   force gradient boosting
#   logistic  force the transparent baseline
# ---------------------------------------------------------------------------
PREFERRED_MODEL=auto
BASELINE_MODEL=logistic
