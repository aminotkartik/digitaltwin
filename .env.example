# ===========================================================================
# VitalSync — Environment Configuration Template
# ===========================================================================
# Copy to .env for local development:
#   cp .env.example .env
#
# All variables are optional. When GROQ_API_KEY is omitted, VitalSync
# automatically uses its deterministic clinical interpretation templates.
# Never commit real API keys or secrets to version control.
# ===========================================================================

# Application environment: prototype | staging | production
ENVIRONMENT=prototype
HOST=0.0.0.0
PORT=8000

# Optional Groq LLM clinical interpretation layer
# Leave blank to run in deterministic offline mode.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TIMEOUT_SECONDS=25.0
GROQ_MAX_TOKENS=900
GROQ_TEMPERATURE=0.2
GROQ_FORCE_DISABLED=false

# Clinical event definition & display bands
GLUCOSE_HIGH_THRESHOLD_MGDL=180.0
GLUCOSE_RISE_DELTA_MGDL=25.0
GLUCOSE_LOW_THRESHOLD_MGDL=70.0
FORECAST_HORIZON_MINUTES=120
RISK_MODERATE_MIN=0.35
RISK_HIGH_MIN=0.70

# Demo scenario settings
DEMO_PATIENT_ID=DT-1047
DEMO_STREAM_END_CLOCK=15:00
DEMO_NOW_CLOCK=10:45
DEMO_SIMULATION_START_CLOCK=09:30

# Keep false on serverless/production to avoid writing to read-only source trees
PERSIST_SENSOR_FILES=false
