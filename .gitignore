# ---------------------------------------------------------------------------
# Secrets — never commit these
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
ENV/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
build/
dist/
*.egg-info/
.eggs/

# ---------------------------------------------------------------------------
# Node (only used to vendor browser libraries; no build step at runtime)
# ---------------------------------------------------------------------------
node_modules/
package-lock.json
npm-debug.log*

# ---------------------------------------------------------------------------
# Generated data
#
# The training cohort is large (~8 MB compressed) but fully reproducible from a
# fixed seed in about fifteen seconds:
#     python datasets/synthetic/generate_cohort.py
# Its provenance record (dataset_metadata.json) and the per-patient profiles
# (cohort_patients.json) ARE committed, so the committed model artifacts can
# always be traced back to the exact configuration they were trained on.
# ---------------------------------------------------------------------------
datasets/synthetic/cohort_features.csv.gz
datasets/synthetic/cohort_features.csv

# Per-patient demo signal exports are regenerated by the API on start-up.
# They are small and committed deliberately so the data-provenance page can
# cite real files with checksums.

# ---------------------------------------------------------------------------
# Editors / OS
# ---------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ---------------------------------------------------------------------------
# Demo recordings (large binaries; add your own via Git LFS if needed)
# ---------------------------------------------------------------------------
video/*.mp4
video/*.mov
video/*.webm
